    {
      "name": "inspector::SceneMetadata-v5",
      "jsonSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "serializationType": "optional",
            "optionalJsonSchema": {
              "type": "string",
              "serializationType": "utf8-string"
            }
          },
          "description": {
            "type": "string",
            "serializationType": "optional",
            "optionalJsonSchema": {
              "type": "string",
              "serializationType": "utf8-string"
            }
          },
